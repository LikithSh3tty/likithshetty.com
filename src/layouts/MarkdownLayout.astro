---
import '../styles/markdown.css'

// Astro hands markdown pages their frontmatter under this prop. The defaults
// keep the resume working if a page omits them.
interface Props {
  frontmatter?: {
    title?: string
    description?: string
    // Emitted verbatim as JSON-LD. Project pages use it to declare
    // SoftwareSourceCode; pages that omit it emit no schema at all.
    schema?: Record<string, unknown>
  }
}

const { frontmatter } = Astro.props

const title = frontmatter?.title ?? 'Likith Shetty'
const description =
  frontmatter?.description ??
  'Likith Shetty — M.Sc. AI & ML student in Bengaluru building agents, retrieval systems and the occasional optimizer.'
const canonicalUrl = new URL(Astro.url.pathname, 'https://likithshetty.com').href
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link
      rel="icon"
      type="image/png"
      href="/assets/images/icon-32.png"
      sizes="32x32"
    />

    {
      frontmatter?.schema && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(frontmatter.schema)}
        />
      )
    }

    <title>{title}</title>
  </head>
  <body>
    <article class="markdown-body">
      <slot />
    </article>
  </body>
</html>
