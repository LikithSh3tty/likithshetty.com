---
import TVLayout from '../layouts/TVLayout.astro'

// Hand-listed rather than a content collection: there is one post. Add entries
// here as more land, and switch to a glob when the list stops fitting on screen.
const posts = [
  {
    title: 'Why Small Language Models Might Be the Future',
    url: '/writing/why-small-language-models-might-be-the-future/',
    date: '2026-07-20',
    blurb:
      'Cheaper inference, on-device deployment, easier specialisation, and the agentic architectures small models unlock.',
  },
]

const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  })
---

<TVLayout title="writing" description="Things Likith Shetty has written about AI.">
  <article class="writing">
    <h1 class="sr-only">Writing by Likith Shetty</h1>
    <p class="intro">Occasionally I write things down.</p>

    <ul class="posts">
      {
        posts.map((post) => (
          <li>
            <a href={post.url}>{post.title}</a>
            <p class="blurb">{post.blurb}</p>
            <time datetime={post.date}>{formatDate(post.date)}</time>
          </li>
        ))
      }
    </ul>
  </article>
</TVLayout>

<style>
  .intro {
    margin: 0 0 1.6rem;
    color: var(--text-primary);
    font-size: var(--font-size-primary);
  }

  .posts {
    margin: 0;
    padding: 0;
    list-style: none;

    & li + li {
      margin-top: 1.6rem;
    }
  }

  .blurb {
    margin: 0.3rem 0 0.2rem;
    color: var(--text-secondary);
  }

  time {
    color: var(--text-secondary);
    font-size: var(--font-size-secondary);
  }
</style>
