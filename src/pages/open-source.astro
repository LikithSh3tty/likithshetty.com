---
import TVLayout from '../layouts/TVLayout.astro'
import { projects } from '../modules/projects'
import ProjectList from '../components/ProjectList.astro'
---

<TVLayout
  title="open-source"
  description="Open-source projects by Likith Shetty — LangGraph agents, semantic retrieval, MLOps drift detection, explainable credit risk, indoor navigation and a CNN written from scratch."
>
  <article>
    <h1 class="sr-only">Open-source projects by Likith Shetty</h1>
    <p class="intro">
      Everything here is public and runnable. Most of it is some variation on
      one idea: a system that knows the edge of what it knows and says so rather
      than guessing. Four of them are also <a href="/websites/">live</a>, and
      two have a write-up on how they work.
    </p>
    <ProjectList items={projects.opensource} />
  </article>
</TVLayout>

<style>
  .intro {
    margin: 0 0 2.6rem;
    max-width: 46rem;
    color: var(--text-primary);
    font-size: var(--font-size-primary);
  }
</style>
